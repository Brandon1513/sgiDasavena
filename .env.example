APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAIL_FROM=
# MS_MAIL_FROM_SOPORTE=soporte@dasavena.com
# MS_MAIL_TO_SOPORTE=aux.sistemas@dasavena.com

# SharePoint (publicación del archivo oficial de cada versión de documento).
# Reusa la misma app de Entra ID de MS_CLIENT_ID/MS_CLIENT_SECRET/MS_TENANT_ID,
# con permiso Sites.Selected (Application) otorgado solo a este sitio (ver README).
SP_SITE_HOST=
SP_SITE_PATH=
# site_id ya resuelto, formato "{host},{siteCollectionId},{webId}" (opcional:
# si se deja vacío, se resuelve por host+path y se cachea)
SP_SITE_ID=
SP_DRIVE_NAME=Documentos
SP_DRIVE_ID=
SP_ROOT_FOLDER=
SP_OBSOLETO_ROOT_FOLDER=
SP_CACHE_TTL=3600
MS_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"

# Integración con Mesa de Ayuda (los tickets del chatbot se reenvían ahí):
# token emitido con `php artisan integrations:sgidasavena:token` en ese proyecto.
MESA_AYUDA_BASE_URL=
MESA_AYUDA_API_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
